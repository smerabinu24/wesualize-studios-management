// Wesualize Studio Management System — normalized production schema.
// PostgreSQL. Indexes, constraints and relations tuned for dashboard/analytics reads.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection (Neon PgBouncer) — used by the app at runtime on serverless.
  url = env("DATABASE_URL")
  // Direct (unpooled) connection — used by `prisma migrate`. Falls back to url locally.
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────

enum Role {
  ADMIN // CEO / Administrator
  TEAM_LEAD
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  COMPLETED
  ON_HOLD
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum MilestoneStatus {
  PENDING
  REACHED
  MISSED
}

enum NotificationType {
  TASK_ASSIGNED
  DEADLINE_APPROACHING
  PROJECT_DELAYED
  OVERLOADED
  MENTION
  SYSTEM
}

// ──────────────────────────────────────────────────────────────
// Identity & access
// ──────────────────────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  role         Role    @default(EMPLOYEE)
  isActive     Boolean @default(true)

  // 1:1 link to the employee profile (CEO is also an employee record).
  employee Employee?

  passwordResets PasswordResetToken[]
  activityLogs   ActivityLog[]
  notifications  Notification[]
  assignedTasks  Task[]               @relation("TaskAssignedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ──────────────────────────────────────────────────────────────
// Org structure
// ──────────────────────────────────────────────────────────────

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  employees Employee[]
  createdAt DateTime   @default(now())
}

model Employee {
  id           String         @id @default(cuid())
  userId       String         @unique
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  designation  String // e.g. "3D Artist", "Motion Designer"
  departmentId String?
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  joiningDate  DateTime       @default(now())
  status       EmployeeStatus @default(ACTIVE)
  avatarUrl    String?
  weeklyCapacityHours Int     @default(40)
  /// Cost rate used for project expense totals. Null = not set / excluded from costing.
  hourlyRate   Decimal?       @db.Decimal(10, 2)

  projectMemberships ProjectMember[]
  tasks              Task[]          @relation("TaskAssignee")
  collaborations     TaskCollaborator[]
  ledProjects        Project[]       @relation("ProjectLead")
  timeEntries        TimeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([status])
  @@index([name])
}

// ──────────────────────────────────────────────────────────────
// Clients & projects
// ──────────────────────────────────────────────────────────────

model Client {
  id          String    @id @default(cuid())
  clientName  String
  companyName String?
  email       String?
  phone       String?
  country     String?
  notes       String?
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientName])
  @@index([companyName])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  clientId    String?
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leadId      String?
  lead        Employee?     @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  startDate   DateTime      @default(now())
  deadline    DateTime?
  budget      Decimal?      @db.Decimal(12, 2)
  status      ProjectStatus @default(PLANNING)
  priority    Priority      @default(MEDIUM)
  /// Set when hidden from active views (auto after 7 days completed, or manually). Data is retained.
  archivedAt  DateTime?
  /// Cleared when someone manually restores the project — see Task.autoArchive.
  autoArchive Boolean   @default(true)

  members     ProjectMember[]
  tasks       Task[]
  milestones  Milestone[]
  timeEntries TimeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([clientId])
  @@index([leadId])
  @@index([deadline])
  @@index([archivedAt])
}

// Join table: employees <-> projects (many-to-many) with an in-project role.
model ProjectMember {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  roleInProject String?
  allocationPct Int    @default(100)
  assignedAt DateTime @default(now())

  @@unique([projectId, employeeId])
  @@index([employeeId])
  @@index([projectId])
}

model Milestone {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime?
  status    MilestoneStatus @default(PENDING)
  createdAt DateTime        @default(now())

  @@index([projectId])
}

// ──────────────────────────────────────────────────────────────
// Tasks
// ──────────────────────────────────────────────────────────────

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?
  projectId      String
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId     String?
  assignee       Employee?  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignedById   String?
  assignedBy     User?      @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  dueDate        DateTime?
  priority       Priority   @default(MEDIUM)
  status         TaskStatus @default(TODO)
  estimatedHours Float      @default(0)
  actualHours    Float      @default(0)
  completedAt    DateTime?
  /// Set when hidden from active views (auto after 7 days done, or manually). Data is retained.
  archivedAt     DateTime?
  /// Cleared when someone manually restores the task, so the sweep does not
  /// immediately re-archive work that was deliberately pulled back.
  autoArchive    Boolean    @default(true)

  timeEntries   TimeEntry[]
  /// Extra people working the task alongside `assignee` (the primary owner).
  collaborators TaskCollaborator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
  @@index([assigneeId, status]) // workload queries
  @@index([archivedAt])
  @@index([status, completedAt, archivedAt]) // auto-archive sweep
}

/// Additional assignees on a task. `Task.assignee` stays the primary owner so
/// existing workload, reporting and time-tracking queries keep working.
model TaskCollaborator {
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([taskId, employeeId])
  @@index([employeeId])
}

// ──────────────────────────────────────────────────────────────
// Observability
// ──────────────────────────────────────────────────────────────

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // e.g. "project.create", "auth.login"
  entityType String? // "Project", "Task", ...
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

// ──────────────────────────────────────────────────────────────
// Time tracking
// ──────────────────────────────────────────────────────────────

enum TimeEntryKind {
  ATTENDANCE // whole-workday clock in/out
  TASK       // time spent on a specific task/project
}

model TimeEntry {
  id         String        @id @default(cuid())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind       TimeEntryKind
  taskId     String?
  task       Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  projectId  String?
  project    Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  startedAt  DateTime      @default(now())
  endedAt    DateTime? // null = currently running
  note       String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([employeeId, kind, endedAt]) // find the running entry fast
  @@index([employeeId, startedAt])
  @@index([taskId])
  @@index([projectId])
}
