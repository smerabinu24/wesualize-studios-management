# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://wesualise:wesualise@localhost:5432/wesualise?schema=public"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Workload threshold (active tasks) above which an employee is flagged "overloaded"
WORKLOAD_THRESHOLD="6"
