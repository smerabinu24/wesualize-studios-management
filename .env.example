# ── Database ────────────────────────────────────────────────────
# Local dev: both point at your local Postgres.
# Production (Neon): DATABASE_URL = POOLED connection string (has "-pooler"),
#                    DIRECT_URL   = DIRECT connection string (no "-pooler").
# The app uses the pooled URL; `prisma migrate` uses the direct URL.
DATABASE_URL="postgresql://wesualise:wesualise@localhost:5432/wesualise?schema=public"
DIRECT_URL="postgresql://wesualise:wesualise@localhost:5432/wesualise?schema=public"

# ── Auth.js / NextAuth ──────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# Production: your deployed URL, e.g. https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Active-task count above which an employee is flagged "overloaded"
WORKLOAD_THRESHOLD="6"
